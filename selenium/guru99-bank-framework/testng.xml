<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Guru99 Bank Suite" verbose="1">
    <listeners>
        <listener class-name="com.bank.framework.utils.TestListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.bank.tests.LoginTests"/>
        </classes>
    </test>

    <test name="Customer Tests">
        <classes>
            <class name="com.bank.tests.CustomerTests"/>
        </classes>
    </test>

    <test name="Account Tests">
        <classes>
            <class name="com.bank.tests.AccountTests"/>
        </classes>
    </test>

    <test name="Transaction Tests">
        <classes>
            <class name="com.bank.tests.TransactionTests"/>
        </classes>
    </test>
</suite>
